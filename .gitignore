# =========================================================================
# AIRA AI Assistant - Git Ignore Rules
# Designed for safe, clean GitHub pushes without bloat, secrets, or large weights.
# =========================================================================

# --- Python & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# --- Virtual Environments ---
.venv/
venv/
env/
ENV/
.conda/
.env/
venv.bak/
env.bak/
.python-version

# --- Node / Frontend ---
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.vite/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Environment & Credentials ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# --- Personal Data, Memory & Chat History ---
backend/MEMORY/history.json
backend/MEMORY/*.tmp

# --- Model Artifacts, Weights & Quantizations (>100MB blocked by GitHub) ---
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
*.bin
*.h5
*.pkl
*.joblib
*.npy
*.npz
*.gguf
backend/BRAIN/models/
backend/brain/models/
**/models/blobs/
**/models/manifests/

# --- 3D / Blender Auto-Backups ---
*.blend1
*.blend2
*.blend@

# --- Generated Audio / Video Files ---
*.wav
*.mp3
*.mp4
frontend/video.mp4

# --- Testing & Coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# --- IDEs & Editors ---
.vscode/
.idea/
.claude/
*.swp
*.swo
*~

# --- OS System Files ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs & Temp Files ---
*.log
logs/
*.tmp
*.temp
laya_repo/
